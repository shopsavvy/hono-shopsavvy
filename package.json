{
  "name": "@shopsavvy/hono",
  "version": "1.0.0",
  "description": "Edge-native Hono middleware and router for ShopSavvy product search and price comparison",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./components": {
      "import": "./dist/components/index.js",
      "types": "./dist/components/index.d.ts"
    },
    "./cache": {
      "import": "./dist/cache/index.js",
      "types": "./dist/cache/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "hono",
    "shopsavvy",
    "price-comparison",
    "middleware",
    "edge",
    "cloudflare-workers",
    "vercel-edge",
    "openapi",
    "sse"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shopsavvy/hono-shopsavvy"
  },
  "homepage": "https://shopsavvy.com/integrations/hono",
  "peerDependencies": {
    "hono": ">=4.0.0",
    "zod": ">=3.0.0"
  },
  "dependencies": {
    "@hono/zod-openapi": "^0.18.0",
    "@hono/zod-validator": "^0.4.0",
    "@shopsavvy/sdk": "latest",
    "hono": "^4.6.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241018.0",
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
